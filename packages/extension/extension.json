{
  "id": "builtin.todo",
  "name": "Todo",
  "workerName": "Todo Worker",
  "description": "Find todo comments in the current project",
  "repository": "https://github.com/lvce-editor/todo",
  "browser": "dist/todoMain.js",
  "isolated": true,
  "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"],
  "categories": ["Other"],
  "activation": [
    "onView:todo.views.todos",
    "onCommand:todo.refresh",
    "onCommand:todo.show"
  ],
  "commands": [
    {
      "id": "todo.show",
      "label": "Todo: Show"
    },
    {
      "id": "todo.refresh",
      "label": "Todo: Refresh"
    }
  ],
  "views": [
    {
      "css": "media/todo.css",
      "displayName": "Todo",
      "eventListeners": [
        {
          "name": "handleClick",
          "params": ["handleClick", "event.currentTarget.name"]
        }
      ],
      "id": "todo.views.todos",
      "title": "Todo",
      "icon": "media/todo.svg",
      "kind": "virtualDom"
    }
  ],
  "keybindings": [
    {
      "key": "Ctrl+R",
      "command": "todo.refresh",
      "when": "todo.todosFocus"
    }
  ]
}
